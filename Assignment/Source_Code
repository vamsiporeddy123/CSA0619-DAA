    )

    print(
        "Distance:",
        format(dc[0], ".8f")
    )

    print()
    print(
        "HYBRID ALGORITHM"
    )

    print(
        "Threshold:",
        best_threshold
    )

    print(
        "Time:",
        format(hy_time, ".6f"),
        "seconds"
    )

    print(
        "Distance Computations:",
        hy[3]
    )

    print(
        "Peak Memory:",
