    print("Number of records:", len(points))

    # Input sizes
    input_sizes = [
        10,
        20,
        40,
        60,
        80,
        100
    ]

    # Threshold values
    thresholds = [
        4,
        8,
        12,
        16,
        20,
        24,
        32
    ]

    # --------------------------------------------------------
    # THRESHOLD EXPERIMENT
    # --------------------------------------------------------

    print()
    print("=" * 70)
    print("THRESHOLD EXPERIMENT")
    print("=" * 70)

    threshold_results = []

    for threshold in thresholds:

        total_time = 0

        for size in input_sizes:

            test_points = points[:size]

            result, execution_time, memory = measure_algorithm(
                lambda p: hybrid(p, threshold),
                test_points
            )

            total_time += execution_time

        average_time = (
            total_time /
            len(input_sizes)
        )

        threshold_results.append(
            (threshold, average_time)
        )

        print(
            "Threshold =",
            threshold,
            "Average Time =",
            format(average_time, ".6f"),
            "seconds"
        )

    # Find best threshold
    best_threshold, best_time = min(
        threshold_results,
        key=lambda x: x[1]
    )

    print()
    print(
        "BEST THRESHOLD =",
        best_threshold
    )

    print(
        "Best Average Time =",
        format(best_time, ".6f"),
        "seconds"
    )

    # --------------------------------------------------------
    # FINAL BENCHMARK
    # --------------------------------------------------------

    print()
    print("=" * 70)
    print("FINAL PERFORMANCE COMPARISON")
    print("=" * 70)

    results = []

    for size in input_sizes:

        test_points = points[:size]

        # Brute Force
        bf_result, bf_time, bf_memory = measure_algorithm(
            brute_force,
            test_points
        )

        # Divide and Conquer
        dc_result, dc_time, dc_memory = measure_algorithm(
            divide_and_conquer,
            test_points
        )

        # Hybrid
        hy_result, hy_time, hy_memory = measure_algorithm(
            lambda p: hybrid(
                p,
                best_threshold
            ),
            test_points
        )

        # Correctness validation
        correct = (
            abs(
                bf_result[0] -
                dc_result[0]
            ) < 1e-12
            and
            abs(
                bf_result[0] -
                hy_result[0]
            ) < 1e-12
        )

        results.append(
            (
                size,
                bf_time,
                dc_time,
                hy_time,
                bf_result[3],
                dc_result[3],
                hy_result[3],
                bf_memory,
                dc_memory,
                hy_memory,
                correct
            )
        )

        print()
        print("Input Size:", size)

        print(
            "Brute Force     :",
            format(bf_time, ".6f"),
            "sec | Comparisons:",
            bf_result[3]
        )

        print(
            "Divide & Conquer:",
            format(dc_time, ".6f"),
            "sec | Comparisons:",
            dc_result[3]
        )

        print(
            "Hybrid (T=" +
            str(best_threshold) +
            ")       :",
            format(hy_time, ".6f"),
            "sec | Comparisons:",
            hy_result[3]
        )

        print(
            "Correctness     :",
            correct
        )

    # --------------------------------------------------------
    # 100 RECORD FINAL RESULT
    # --------------------------------------------------------

    final_points = points[:100]

    bf, bf_time, bf_memory = measure_algorithm(
        brute_force,
        final_points
    )

