import csv
import math
import time
import tracemalloc
import statistics
import os

# ============================================================
# DEVELOPMENT OF AN EFFICIENT HYBRID ALGORITHMIC SOLUTION
# FOR LARGE-SCALE GEOSPATIAL DATA PROCESSING
#
# Closest Pair of Points
# Algorithms:
# 1. Brute Force
# 2. Divide and Conquer
# 3. Hybrid
# ============================================================


# ------------------------------------------------------------
# LOAD DATASET
# ------------------------------------------------------------

def load_dataset(filename):
    points = []

    with open(filename, "r", encoding="utf-8") as file:
        reader = csv.DictReader(file)

        for row in reader:
            try:
                latitude = float(row["latitude"])
                longitude = float(row["longitude"])
                name = row["name"]
                point_id = int(row["id"])

                points.append(
                    (latitude, longitude, name, point_id)
                )

            except (ValueError, KeyError):
                continue

    return points


# ------------------------------------------------------------
# EUCLIDEAN DISTANCE
# ------------------------------------------------------------

def calculate_distance(p1, p2, counter):
    counter[0] += 1

    dx = p1[0] - p2[0]
    dy = p1[1] - p2[1]

    return math.sqrt(dx * dx + dy * dy)


# ------------------------------------------------------------
# BRUTE FORCE
# ------------------------------------------------------------

def brute_force(points):

    counter = [0]

    minimum_distance = float("inf")
    best_p1 = None
    best_p2 = None

    n = len(points)

    for i in range(n):
        for j in range(i + 1, n):

            distance = calculate_distance(
                points[i],
                points[j],
                counter
            )

            if distance < minimum_distance:
                minimum_distance = distance
                best_p1 = points[i]
                best_p2 = points[j]

    return (
        minimum_distance,
        best_p1,
        best_p2,
        counter[0]
    )


# ------------------------------------------------------------
# DIVIDE AND CONQUER
# ------------------------------------------------------------

def divide_and_conquer(points):

    points_x = sorted(
        points,
        key=lambda p: (p[0], p[1])
    )

    points_y = sorted(
        points,
        key=lambda p: (p[1], p[0])
    )

    return divide_recursive(points_x, points_y)


def divide_recursive(points_x, points_y):

    n = len(points_x)

    # Base case
    if n <= 3:

        result = brute_force(points_x)

        return result

    # Find middle
    middle = n // 2

    left_x = points_x[:middle]
    right_x = points_x[middle:]

    middle_x = right_x[0][0]

    # IDs of left-side points
    left_ids = set()

    for point in left_x:
        left_ids.add(point[3])

    left_y = []
    right_y = []

    for point in points_y:

        if point[3] in left_ids:
            left_y.append(point)

        else:
            right_y.append(point)

    # Recursive calls
    left_result = divide_recursive(
        left_x,
        left_y
    )

    right_result = divide_recursive(
        right_x,
        right_y
    )

    # Select smaller result
    if left_result[0] <= right_result[0]:
        best = left_result

    else:
        best = right_result

    minimum_distance = best[0]
    best_p1 = best[1]
    best_p2 = best[2]

    distance_count = (
        left_result[3] +
        right_result[3]
    )

    # Create dividing strip
    strip = []

    for point in points_y:

        if abs(point[0] - middle_x) < minimum_distance:
            strip.append(point)

    strip_counter = [0]

    # Check nearby points in y direction
    for i in range(len(strip)):

        for j in range(
            i + 1,
            min(i + 8, len(strip))
        ):

            if (
                strip[j][1] -
                strip[i][1]
                >= minimum_distance
            ):
                break

            distance = calculate_distance(
                strip[i],
                strip[j],
                strip_counter
            )

            if distance < minimum_distance:

                minimum_distance = distance
                best_p1 = strip[i]
                best_p2 = strip[j]

    total_count = (
        distance_count +
        strip_counter[0]
    )

    return (
        minimum_distance,
        best_p1,
        best_p2,
        total_count
    )


# ------------------------------------------------------------
# HYBRID ALGORITHM
# ------------------------------------------------------------

def hybrid(points, threshold):

    points_x = sorted(
        points,
        key=lambda p: (p[0], p[1])
    )

    points_y = sorted(
        points,
        key=lambda p: (p[1], p[0])
    )

    return hybrid_recursive(
        points_x,
        points_y,
        threshold
    )


def hybrid_recursive(
        points_x,
        points_y,
        threshold):

    n = len(points_x)

    # Hybrid switching condition
    if n <= threshold:

        return brute_force(points_x)

    middle = n // 2

    left_x = points_x[:middle]
    right_x = points_x[middle:]

    middle_x = right_x[0][0]

    left_ids = set()

    for point in left_x:
        left_ids.add(point[3])

    left_y = []
    right_y = []

    for point in points_y:

        if point[3] in left_ids:
            left_y.append(point)

        else:
            right_y.append(point)

    # Recursive processing
    left_result = hybrid_recursive(
        left_x,
        left_y,
        threshold
    )

    right_result = hybrid_recursive(
        right_x,
        right_y,
        threshold
    )

    if left_result[0] <= right_result[0]:
        best = left_result

    else:
        best = right_result

    minimum_distance = best[0]
    best_p1 = best[1]
    best_p2 = best[2]

    distance_count = (
        left_result[3] +
        right_result[3]
    )

    # Dividing strip
    strip = []

    for point in points_y:

        if abs(point[0] - middle_x) < minimum_distance:
            strip.append(point)

    strip_counter = [0]

    for i in range(len(strip)):

        for j in range(
            i + 1,
            min(i + 8, len(strip))
        ):

            if (
                strip[j][1] -
                strip[i][1]
                >= minimum_distance
            ):
                break

            distance = calculate_distance(
                strip[i],
                strip[j],
                strip_counter
            )

            if distance < minimum_distance:

                minimum_distance = distance
                best_p1 = strip[i]
                best_p2 = strip[j]

    total_count = (
        distance_count +
        strip_counter[0]
    )

    return (
        minimum_distance,
        best_p1,
        best_p2,
        total_count
    )


# ------------------------------------------------------------
# PERFORMANCE MEASUREMENT
# ------------------------------------------------------------

def measure_algorithm(function, points):

    tracemalloc.start()

    start_time = time.perf_counter()

    result = function(points)

    end_time = time.perf_counter()

    current, peak = tracemalloc.get_traced_memory()

    tracemalloc.stop()

    execution_time = end_time - start_time

    peak_memory_kb = peak / 1024

    return (
        result,
        execution_time,
        peak_memory_kb
    )


