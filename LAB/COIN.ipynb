      "source": [
        "# Coin Change - Minimum Coins\n",
        "\n",
        "coins = [1, 2, 5]\n",
        "amount = 11\n",
        "\n",
        "dp = [999] * (amount + 1)\n",
        "dp[0] = 0\n",
        "\n",
        "for i in range(1, amount + 1):\n",
        "    for coin in coins:\n",
        "        if coin <= i:\n",
        "            dp[i] = min(dp[i], dp[i-coin] + 1)\n",
        "\n",
        "print(\"Minimum coins:\", dp[amount])"
      ]
    }
  ]
}