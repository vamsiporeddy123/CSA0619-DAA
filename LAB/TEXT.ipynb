      "source": [
        "# Naive String Matching\n",
        "\n",
        "text = \"AABAACAADAABAABA\"\n",
        "pattern = \"AABA\"\n",
        "\n",
        "for i in range(len(text) - len(pattern) + 1):\n",
        "    if text[i:i+len(pattern)] == pattern:\n",
        "        print(\"Pattern found at index:\", i)"
      ]
    }
  ]
