      "source": [
        "# Container Loading\n",
        "\n",
        "weights = [10, 20, 30, 40]\n",
        "capacity = 50\n",
        "\n",
        "weights.sort()\n",
        "\n",
        "total = 0\n",
        "count = 0\n",
        "\n",
        "for w in weights:\n",
        "    if total + w <= capacity:\n",
        "        total += w\n",
        "        count += 1\n",
        "\n",
        "print(\"Number of containers loaded:\", count)\n",
        "print(\"Total weight:\", total)"
      ]
    }
  ]
}